# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://medai_user:medai_pass@localhost:5432/medai_db

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── DeepSeek V3 ─────────────────────────────────────
DEEPSEEK_API_KEY=sk-9b6626466a2444abb052aeae3d614ef3
DEEPSEEK_MODEL=deepseek-v4-flash

# ─── ChromaDB ─────────────────────────────────────────
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=medai_knowledge

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20

# ─── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
