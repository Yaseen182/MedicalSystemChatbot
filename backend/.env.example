# ─── Server ───────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ─── PostgreSQL ───────────────────────────────────────
DATABASE_URL=postgresql://medai_user:medai_pass@localhost:5432/medai_db

# ─── Redis ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Resend (email OTP verification) ──────────────────
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=MedAI <onboarding@resend.dev>
OTP_TTL_MINUTES=10

# ─── Python AI Service ────────────────────────────────
# All AI logic (LLM agents + RAG) now runs in the Python service (/ai-service).
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_TIMEOUT_MS=120000

# ─── Rate Limiting ────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20

# ─── Frontend ─────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
