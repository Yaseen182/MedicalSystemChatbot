{
  "name": "medai-backend",
  "version": "1.0.0",
  "description": "MedAI Backend — Node.js/Express AI medical assistant API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node -e \"require('axios').post((process.env.AI_SERVICE_URL||'http://localhost:8001')+'/seed').then(r=>console.log('Seeded:',r.data)).catch(e=>{console.error(e.response?.data||e.message);process.exit(1)})\""
  },
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "redis": "^4.6.14",
    "resend": "^6.16.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
